---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

function parseOptionalId(rawValue: string | null): number | null {
  if (rawValue === null || rawValue.trim() === '') {
    return null;
  }

  const value = Number(rawValue);
  return Number.isInteger(value) && value > 0 ? value : null;
}

const selectedPublisherId = parseOptionalId(Astro.url.searchParams.get('publisher'));
const selectedCategoryId = parseOptionalId(Astro.url.searchParams.get('category'));
const allPublishers = await getAllPublishers(getDatabase());
const allCategories = await getAllCategories(getDatabase());
const games = await getAllGames(getDatabase(), {
  publisherId: selectedPublisherId ?? undefined,
  categoryId: selectedCategoryId ?? undefined,
});
const hasActiveFilters = selectedPublisherId !== null || selectedCategoryId !== null;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/70 p-5 shadow-lg">
      <form method="get" data-testid="games-filters" class="space-y-5">
        <div class="grid gap-4 md:grid-cols-2">
          <label class="block">
            <span class="mb-2 block text-sm font-medium text-slate-200">Publisher</span>
            <select
              name="publisher"
              data-testid="publisher-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="" selected={selectedPublisherId === null}>All publishers</option>
              {allPublishers.map((publisher) => (
                <option value={publisher.id} selected={selectedPublisherId === publisher.id}>
                  {publisher.name}
                </option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="mb-2 block text-sm font-medium text-slate-200">Category</span>
            <select
              name="category"
              data-testid="category-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="" selected={selectedCategoryId === null}>All categories</option>
              {allCategories.map((category) => (
                <option value={category.id} selected={selectedCategoryId === category.id}>
                  {category.name}
                </option>
              ))}
            </select>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            data-testid="apply-filters"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Apply filters
          </button>

          <a
            href="/"
            data-testid="clear-filters"
            hidden={!hasActiveFilters}
            class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Clear filters
          </a>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div hidden={games.length !== 0} data-testid="games-empty-state">
        <EmptyState
          text={
            hasActiveFilters ? 'No games match the selected filters.' : 'No games available at the moment.'
          }
        />
      </div>

      <div hidden={games.length === 0} class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const publisherFilter = document.querySelector('[data-testid="publisher-filter"]');
    const categoryFilter = document.querySelector('[data-testid="category-filter"]');
    const clearFilters = document.querySelector('[data-testid="clear-filters"]');
    const gamesGrid = document.querySelector('[data-testid="games-grid"]');
    const emptyState = document.querySelector('[data-testid="games-empty-state"]');
    const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));

    const selectedPublisherId = params.get('publisher');
    const selectedCategoryId = params.get('category');

    if (publisherFilter && selectedPublisherId) {
      const matchingOption = Array.from(publisherFilter.querySelectorAll('option')).find(
        (option) => option.value === selectedPublisherId,
      );

      if (matchingOption) {
        publisherFilter.value = selectedPublisherId;
      }
    }

    if (categoryFilter && selectedCategoryId) {
      const matchingOption = Array.from(categoryFilter.querySelectorAll('option')).find(
        (option) => option.value === selectedCategoryId,
      );

      if (matchingOption) {
        categoryFilter.value = selectedCategoryId;
      }
    }

    const filtersActive = Boolean(selectedPublisherId || selectedCategoryId);

    if (clearFilters) {
      clearFilters.hidden = !filtersActive;
    }

    let visibleCount = 0;

    cards.forEach((card) => {
      const shouldDisplay =
        (!selectedPublisherId || card.getAttribute('data-game-publisher-id') === selectedPublisherId) &&
        (!selectedCategoryId || card.getAttribute('data-game-category-id') === selectedCategoryId);

      card.hidden = !shouldDisplay;

      if (shouldDisplay) {
        visibleCount += 1;
      }
    });

    if (gamesGrid) {
      gamesGrid.hidden = visibleCount === 0;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount !== 0;
    }
  });
</script>
