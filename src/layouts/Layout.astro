---
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script is:inline>
            const storedHighContrastPreference = window.localStorage.getItem('tailspin-high-contrast');
            const highContrastEnabled = storedHighContrastPreference === 'true';
            document.documentElement.dataset.highContrast = String(highContrastEnabled);
        </script>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-slate-900 text-white transition-colors duration-300 m-0 w-full h-full font-sans">
        <Header />
        <main class="container mx-auto py-6 h-full max-w-7xl">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }

    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }

    html[data-high-contrast='true'] body {
        background-color: #000000 !important;
        color: #ffffff !important;
    }

    html[data-high-contrast='true'] .bg-slate-800,
    html[data-high-contrast='true'] .bg-slate-800\/60,
    html[data-high-contrast='true'] .bg-slate-800\/70,
    html[data-high-contrast='true'] .bg-slate-900,
    html[data-high-contrast='true'] .bg-slate-900\/50,
    html[data-high-contrast='true'] .bg-slate-950,
    html[data-high-contrast='true'] .bg-blue-500,
    html[data-high-contrast='true'] .bg-blue-600,
    html[data-high-contrast='true'] .bg-blue-700 {
        background-color: #000000 !important;
    }

    html[data-high-contrast='true'] .text-slate-100,
    html[data-high-contrast='true'] .text-slate-200,
    html[data-high-contrast='true'] .text-slate-300,
    html[data-high-contrast='true'] .text-slate-400,
    html[data-high-contrast='true'] .text-white,
    html[data-high-contrast='true'] .text-blue-400,
    html[data-high-contrast='true'] .text-blue-500 {
        color: #ffffff !important;
    }

    html[data-high-contrast='true'] .border-slate-700,
    html[data-high-contrast='true'] .border-slate-600,
    html[data-high-contrast='true'] .border-slate-500,
    html[data-high-contrast='true'] .border-slate-700\/50 {
        border-color: #ffffff !important;
    }

    html[data-high-contrast='true'] [data-testid='high-contrast-toggle'] {
        background-color: #f8fafc !important;
        color: #020617 !important;
        border-color: #ffffff !important;
    }

    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>
